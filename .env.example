# Пароль для входа в D&N (минимум 6 символов). Без него в рабочем режиме вход закрыт.
DN_APP_PASSWORD=

# Секретный ключ для «Команд» iOS и вебхука Monobank (минимум 16 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DN_INGEST_TOKEN=

# Публичный адрес сайта — нужен, чтобы «Команда» открыла правильную ссылку (например, https://dn.example.com)
# DN_PUBLIC_URL=

# Часовой пояс для границ месяца и лимитов (по умолчанию Europe/Kyiv)
# DN_TZ=Europe/Kyiv

# Путь к базе (по умолчанию ./data/dn.db)
# DN_DB_PATH=./data/dn.db

# Ключ ИИ (https://console.anthropic.com) — для «Разбора от ИИ» в аналитике. Необязательно.
# ANTHROPIC_API_KEY=
